<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!--
      net48 has no lib asset of its own, so it runs the tests against the netstandard2.0 build.
      On by default on Windows; elsewhere pass -p:FilePartyTestNetFx=true to compile it (running needs Windows or Mono).
    -->
    <FilePartyTestNetFx Condition="'$(FilePartyTestNetFx)' == '' AND '$(OS)' == 'Windows_NT'">true</FilePartyTestNetFx>
    <TargetFrameworks Condition="'$(FilePartyTestNetFx)' == 'true'">$(TargetFrameworks);net48</TargetFrameworks>
    <Configurations>Debug-V3;Debug-V4;Release-V3;Release-V4</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug-V3' OR '$(Configuration)' == 'Release-V3'">
    <DefineConstants>$(DefineConstants);AWS_SDK_V3</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug-V4' OR '$(Configuration)' == 'Release-V4'">
    <DefineConstants>$(DefineConstants);AWS_SDK_V4</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug-V3' OR '$(Configuration)' == 'Release-V3'">
    <PackageReference Include="AWSSDK.S3" Version="[3.7.400.1,4)" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug-V4' OR '$(Configuration)' == 'Release-V4'">
    <PackageReference Include="AWSSDK.S3" Version="[4.0.0,5)" />
    <!-- GHSA-9cvc-h2w8-phrp / CVE-2026-22611: AWSSDK.Core 4.0.0 - 4.0.3.2 is vulnerable. -->
    <PackageReference Include="AWSSDK.Core" Version="[4.0.3.3,5)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FileParty.Core\FileParty.Core.csproj"/>
    <ProjectReference Include="..\..\src\FileParty.Providers.AWS.S3\FileParty.Providers.AWS.S3.csproj"/>
  </ItemGroup>
</Project>
