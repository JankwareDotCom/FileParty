<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Produced by: dotnet pack <project> -c Release -p:GeneratePackageOnBuild=false -o artifacts/packages -->
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- FileParty packages must come from the local build, never from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="FileParty.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
